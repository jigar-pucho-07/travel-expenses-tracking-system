              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const tripRows = Array.isArray(inputs.tripData) ? inputs.tripData : [];\n  if (tripRows.length === 0) {\n    return { success: false, error: \"Trip not found\" };\n  }\n  const trip = tripRows[0];\n  const expenses = Array.isArray(inputs.expenses) ? inputs.expenses : [];\n  const cats = { Transportation: 0, Hotel: 0, Food: 0, Cab: 0, Other: 0 };\n  let total = 0;\n  const details = [];\n  expenses.forEach((exp) => {\n    const cat = String(exp.Category || exp.category || \"Other\");\n    const amt = parseFloat(exp.Amount || exp.amount || 0);\n    if (cats.hasOwnProperty(cat)) { cats[cat] += amt; } else { cats.Other += amt; }\n    total += amt;\n    details.push({\n      date: String(exp.Date || exp.date || \"\"),\n      category: cat,\n      merchant: String(exp.Merchant || exp.merchant || \"\"),\n      amount: amt,\n      description: String(exp.Description || exp.description || \"\")\n    });\n  });\n  const budget = parseFloat(trip.Budget || trip.budget || 0);\n  const remaining = budget - total;\n  const empName = String(trip.User_ID || trip.user_id || \"Employee\");\n  const tripName = String(trip.Trip_Name || trip.trip_name || \"Trip\");\n  const dest = String(trip.Destination || trip.destination || \"\");\n  const startDate = String(trip.Start_Date || trip.start_date || \"\");\n  const endDate = String(trip.End_Date || trip.end_date || \"\");\n  const generatedDate = new Date().toISOString().split(\"T\")[0];\n  let reportText = \"=================================\\n\";\n  reportText += \"       TRAVEL EXPENSE REPORT\\n\";\n  reportText += \"=================================\\n\\n\";\n  reportText += \"Employee: \" + empName + \"\\n\";\n  reportText += \"Trip: \" + tripName + \"\\n\";\n  reportText += \"Destination: \" + dest + \"\\n\";\n  reportText += \"Start Date: \" + startDate + \"\\n\";\n  reportText += \"End Date: \" + endDate + \"\\n\\n\";\n  reportText += \"---------------------------------\\n\";\n  reportText += \"EXPENSE SUMMARY\\n\";\n  reportText += \"---------------------------------\\n\\n\";\n  Object.keys(cats).forEach((cat) => {\n    reportText += cat + \": INR \" + cats[cat].toLocaleString(\"en-IN\") + \"\\n\";\n  });\n  reportText += \"\\n---------------------------------\\n\";\n  reportText += \"Total Budget:    INR \" + budget.toLocaleString(\"en-IN\") + \"\\n\";\n  reportText += \"Total Expense:   INR \" + total.toLocaleString(\"en-IN\") + \"\\n\";\n  reportText += \"Remaining:       INR \" + remaining.toLocaleString(\"en-IN\") + \"\\n\";\n  reportText += \"---------------------------------\\n\\n\";\n  reportText += \"EXPENSE DETAILS\\n\";\n  reportText += \"---------------------------------\\n\";\n  reportText += \"Date       | Category       | Merchant         | Amount\\n\";\n  reportText += \"-----------+----------------+------------------+--------\\n\";\n  details.forEach((d) => {\n    reportText += d.date + \" | \" + d.category.padEnd(14) + \" | \" + d.merchant.padEnd(16) + \" | INR \" + d.amount.toLocaleString(\"en-IN\") + \"\\n\";\n  });\n  reportText += \"\\n=================================\\n\";\n  reportText += \"Report Generated: \" + generatedDate + \"\\n\";\n  reportText += \"Trip Status: Completed\\n\";\n  reportText += \"=================================\\n\";\n  return {\n    success: true,\n    report_text: reportText,\n    trip_name: tripName,\n    total: total,\n    budget: budget,\n    remaining: remaining,\n    categories: cats,\n    expense_count: expenses.length\n  };\n};",
                "packageJson": "{}"
              },
