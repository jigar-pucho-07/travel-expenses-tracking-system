              "code": "export const code = async (inputs) => {\n  let rows = [];\n  if (Array.isArray(inputs.userRows)) {\n    rows = inputs.userRows;\n  } else if (inputs.userRows && typeof inputs.userRows === 'object') {\n    rows = inputs.userRows.data || inputs.userRows.rows || [inputs.userRows];\n    if (!Array.isArray(rows)) rows = [rows];\n  }\n\n  if (rows.length === 0) {\n    return { success: 'false', message: 'Invalid email or password', user_json: '{}' };\n  }\n\n  const row = rows[0];\n  const v = row.values || row;\n  const storedPassword = v.D || row.Password || row.password || '';\n\n  if (storedPassword !== inputs.inputPassword) {\n    return { success: 'false', message: 'Invalid email or password', user_json: '{}' };\n  }\n\n  const userObj = {\n    user_id: v.A || row.User_ID || row.user_id || '',\n    name:    v.B || row.Name    || row.name    || '',\n    email:   v.C || row.Email   || row.email   || '',\n    role:    v.E || row.Role    || row.role    || 'Employee'\n  };\n\n  return {\n    success: 'true',\n    message: 'Login successful',\n    user_json: JSON.stringify(userObj)\n  };\n};",
              "packageJson": "{}"
            },
