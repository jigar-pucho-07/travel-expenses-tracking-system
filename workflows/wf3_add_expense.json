                    "schema": {
                      "Expense_ID": { "type": "SHORT_TEXT","required": true,"displayName": "Expense ID","defaultValue": "" },
                      "Trip_ID": { "type": "SHORT_TEXT","required": true,"displayName": "Trip ID","defaultValue": "" },
                      "User_ID": { "type": "SHORT_TEXT","required": true,"displayName": "User ID","defaultValue": "" },
                      "Date": { "type": "SHORT_TEXT","required": true,"displayName": "Date","defaultValue": "" },
                      "Category": { "type": "SHORT_TEXT","required": true,"displayName": "Category","defaultValue": "" },
                      "Subcategory": { "type": "SHORT_TEXT","required": false,"displayName": "Subcategory","defaultValue": "" },
                      "Merchant": { "type": "SHORT_TEXT","required": false,"displayName": "Merchant","defaultValue": "" },
                      "Amount": { "type": "SHORT_TEXT","required": true,"displayName": "Amount","defaultValue": "" },
                      "Currency": { "type": "SHORT_TEXT","required": false,"displayName": "Currency","defaultValue": "INR" },
                      "Payment_Method": { "type": "SHORT_TEXT","required": false,"displayName": "Payment Method","defaultValue": "" },
                      "Description": { "type": "SHORT_TEXT","required": false,"displayName": "Description","defaultValue": "" },
