        "settings": {
          "input": {
            "body": "{{trigger['body']}}"
          },
          "sourceCode": {
            "code": "export const code = async (inputs) => {\n  let b = inputs.body;\n  if (typeof b === 'string') {\n    try { b = JSON.parse(b); } catch { b = {}; }\n  }\n  if (!b || typeof b !== 'object') b = {};\n  const errors = [];\n  if (!b.user_id) errors.push('user_id is required');\n  if (!b.trip_name) errors.push('trip_name is required');\n  if (!b.source) errors.push('source is required');\n  if (!b.destination) errors.push('destination is required');\n  if (!b.start_date) errors.push('start_date is required');\n  if (!b.end_date) errors.push('end_date is required');\n  if (errors.length > 0) {\n    return { success: false, message: 'Validation failed', errors: errors };\n  }\n  const ts = Date.now().toString(36).toUpperCase().slice(-4);\n  const trip_id = 'TRIP-' + ts;\n  return {\n    success: true,\n    trip_id: trip_id,\n    user_id: b.user_id,\n    trip_name: b.trip_name,\n    source: b.source,\n    destination: b.destination,\n    start_date: b.start_date,\n    end_date: b.end_date,\n    purpose: b.purpose || '',\n    budget: b.budget || 0\n  };\n};",
            "packageJson": "{}"
          },
          "sampleData": {},
