                  "sourceCode": {
                    "code": "export const code = async (inputs) => {\n  const d = inputs.tripData || {};\n  const newVals = {\n    user_id: String(d.user_id || '').trim().toLowerCase(),\n    trip_name: String(d.trip_name || '').trim().toLowerCase(),\n    source: String(d.source || '').trim().toLowerCase(),\n    destination: String(d.destination || '').trim().toLowerCase(),\n    start_date: String(d.start_date || '').trim(),\n    end_date: String(d.end_date || '').trim(),\n    purpose: String(d.purpose || '').trim().toLowerCase(),\n    budget: parseFloat(d.budget) || 0\n  };\n\n  let rows = [];\n  if (Array.isArray(inputs.searchResults)) {\n    rows = inputs.searchResults;\n  } else if (inputs.searchResults && typeof inputs.searchResults === 'object') {\n    const vals = inputs.searchResults.data || inputs.searchResults.rows || [];\n    rows = Array.isArray(vals) ? vals : [vals];\n  }\n\n  let duplicate = false;\n  for (const row of rows) {\n    const v = row.values || row;\n    const match =\n      String(v.B || row.User_ID || '').trim().toLowerCase() === newVals.user_id &&\n      String(v.C || row.Trip_Name || '').trim().toLowerCase() === newVals.trip_name &&\n      String(v.D || row.Source || '').trim().toLowerCase() === newVals.source &&\n      String(v.E || row.Destination || '').trim().toLowerCase() === newVals.destination &&\n      String(v.F || row.Start_Date || '').trim() === newVals.start_date &&\n      String(v.G || row.End_Date || '').trim() === newVals.end_date &&\n      String(v.H || row.Purpose || '').trim().toLowerCase() === newVals.purpose &&\n      (parseFloat(v.I || row.Budget || 0)) === newVals.budget;\n    if (match) { duplicate = true; break; }\n  }\n\n  return { duplicate: duplicate };\n};",
                    "packageJson": "{}"
