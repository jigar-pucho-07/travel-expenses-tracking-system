# =============================================================================
# Travel Expense Tracking System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values after importing workflows
# into Pucho AI Studio.
# =============================================================================

# Application name (shown in browser tab)
VITE_APP_NAME=Travel Expense Tracker

# Mock mode — set to "true" to use demo data without any backend
# Set to "false" when webhook URLs are configured for real integration
VITE_IS_MOCK=true

# =============================================================================
# PuchoAI Webhook URLs (REQUIRED for production — import workflows first)
# =============================================================================
# To get each URL:
#   1. Import the workflow JSON from /workflows/ into Pucho AI Studio
#   2. Open the workflow, click the webhook trigger block
#   3. Copy the "Live URL" and paste it below
#   4. Ensure the workflow is Published/Active
#   5. Ensure Google Sheets and Google Drive connections are configured
#      inside each workflow (spreadsheetId, sheetId, auth)
# =============================================================================

# WF1 — Login (validates email/password against Users sheet)
# IMPORTANT: Append /sync to the webhook URL for synchronous response
VITE_WF_LOGIN=

# WF2 — Create Trip (inserts into Trips sheet)
VITE_WF_CREATE_TRIP=

# WF3 — Add Expense (inserts into Expenses sheet)
VITE_WF_ADD_EXPENSE=

# WF4 — Process Receipt (uploads to Drive, runs OCR, returns extracted data)
VITE_WF_PROCESS_RECEIPT=

# WF5 — Trip Summary (fetches expenses, calculates category totals)
VITE_WF_TRIP_SUMMARY=

# WF6 — Complete Trip (generates PDF report, uploads to Drive, updates trip status)
VITE_WF_COMPLETE_TRIP=

# WF7 — List Trips (fetches all trips for a user)
VITE_WF_LIST_TRIPS=

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - These are webhook endpoint URLs only — NO credentials, API keys, or secrets
# - Google Sheets OAuth, Google Drive OAuth, and Pucho model keys are configured
#   INSIDE Pucho AI Studio as Connections, not in this file
# - Never commit .env to version control (it is git-ignored)
# - For production, use Supabase Auth instead of Google Sheets-based password storage
# =============================================================================